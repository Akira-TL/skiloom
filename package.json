{
  "name": "skiloom",
  "version": "0.1.0",
  "description": "Agent Skill package manager and installer",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:compile": "tsc -p tsconfig.test.json",
    "test:unit": "npm run test:compile --silent && node scripts/run-tests.mjs unit",
    "test:behavior": "npm run test:compile --silent && node scripts/run-tests.mjs behavior",
    "test:lock-bridge": "npm run test:compile --silent && node --test .test-dist/test/integration/native/operation-lock.test.js",
    "test:machine-state": "npm run test:compile --silent && node --test .test-dist/test/integration/runtime/machine-state.test.js .test-dist/test/integration/runtime/target/reconciliation.test.js .test-dist/test/integration/runtime/target/local-lifecycle.test.js .test-dist/test/integration/runtime/target/detached-binding.test.js",
    "test:target-projection": "npm run test:compile --silent && node --test .test-dist/test/integration/runtime/target/projection.test.js",
    "test": "npm run test:compile --silent && node scripts/run-tests.mjs all",
    "check": "npm run typecheck && npm run build && npm test"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "smol-toml": "^1.8.0",
    "unicode-case-folding": "^1.1.1",
    "yaml": "^2.9.1"
  }
}
