{
  "name": "skiloom",
  "version": "0.1.0",
  "description": "Agent Skill package manager and installer",
  "type": "module",
  "bin": {
    "skiloom": "./dist/cli/main.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:compile": "tsc -p tsconfig.test.json",
    "test:unit": "npm run test:compile --silent && node scripts/run-tests.mjs unit",
    "test:behavior": "npm run test:compile --silent && node scripts/run-tests.mjs behavior",
    "test:cli": "npm run test:compile --silent && node --test .test-dist/test/integration/cli/validate.test.js .test-dist/test/integration/cli/status.test.js .test-dist/test/integration/cli/doctor/doctor.test.js .test-dist/test/integration/cli/search.test.js .test-dist/test/integration/cli/install.test.js .test-dist/test/integration/cli/update.test.js .test-dist/test/integration/cli/remove.test.js .test-dist/test/integration/cli/sync-repair.test.js .test-dist/test/integration/cli/local-operations.test.js .test-dist/test/integration/cli/recovery/recover.test.js .test-dist/test/integration/cli/transfer/export-import.test.js .test-dist/test/integration/cli/bootstrap.test.js",
    "test:cli-install": "npm run test:compile --silent && node --test .test-dist/test/integration/cli/install.test.js",
    "test:first-party": "npm run test:compile --silent && node --test .test-dist/test/integration/first-party/skill-suite.test.js",
    "test:lock-bridge": "npm run test:compile --silent && node --test .test-dist/test/integration/native/operation-lock.test.js",
    "test:github-source": "npm run test:compile --silent && node --test .test-dist/test/integration/runtime/source/github-repository.test.js .test-dist/test/integration/runtime/source/github-transport.test.js .test-dist/test/integration/runtime/source/github-release.test.js .test-dist/test/integration/runtime/source/github-git-ref.test.js .test-dist/test/integration/runtime/source/github-snapshot.test.js .test-dist/test/integration/runtime/source/github-pipeline.test.js",
    "test:github-source-live": "npm run test:compile --silent && node --test --test-concurrency=1 .test-dist/test/integration/runtime/source/github-live.test.js .test-dist/test/integration/runtime/source/github-git-ref-live.test.js",
    "test:lifecycle": "npm run test:compile --silent && node --test .test-dist/test/integration/runtime/lifecycle/candidate.test.js",
    "test:lifecycle-locked": "npm run test:compile --silent && node --test .test-dist/test/integration/runtime/lifecycle/first-install.test.js .test-dist/test/integration/runtime/lifecycle/add-root.test.js .test-dist/test/integration/runtime/lifecycle/update.test.js .test-dist/test/integration/runtime/lifecycle/remove.test.js .test-dist/test/integration/runtime/lifecycle/completion.test.js .test-dist/test/integration/runtime/lifecycle/policy/acceptance-policy.test.js .test-dist/test/integration/runtime/lifecycle/recovery/interrupted.test.js",
    "test:machine-state": "npm run test:compile --silent && node --test .test-dist/test/integration/runtime/machine-state.test.js .test-dist/test/integration/runtime/target/reconciliation.test.js .test-dist/test/integration/runtime/target/local-lifecycle.test.js .test-dist/test/integration/runtime/target/detached-binding.test.js .test-dist/test/integration/runtime/target/local-lifecycle-safety.test.js .test-dist/test/integration/runtime/lifecycle/first-install.test.js .test-dist/test/integration/runtime/lifecycle/add-root.test.js .test-dist/test/integration/runtime/lifecycle/update.test.js .test-dist/test/integration/runtime/lifecycle/remove.test.js .test-dist/test/integration/runtime/lifecycle/completion.test.js .test-dist/test/integration/runtime/lifecycle/policy/acceptance-policy.test.js .test-dist/test/integration/runtime/lifecycle/recovery/interrupted.test.js .test-dist/test/integration/runtime/export/dependencies.test.js .test-dist/test/integration/runtime/export/full.test.js .test-dist/test/integration/runtime/import/exact.test.js .test-dist/test/integration/runtime/import/merge.test.js .test-dist/test/integration/runtime/reproduction/e2e.test.js .test-dist/test/integration/runtime/import/recovery/exact.test.js .test-dist/test/integration/runtime/import/recovery/merge.test.js",
    "test:target-projection": "npm run test:compile --silent && node --test .test-dist/test/integration/runtime/target/projection.test.js",
    "test": "npm run test:compile --silent && node scripts/run-tests.mjs all && node --test .test-dist/test/integration/runtime/source/github-repository.test.js .test-dist/test/integration/runtime/source/github-transport.test.js .test-dist/test/integration/runtime/source/github-release.test.js .test-dist/test/integration/runtime/source/github-git-ref.test.js .test-dist/test/integration/runtime/source/github-snapshot.test.js .test-dist/test/integration/runtime/source/github-pipeline.test.js .test-dist/test/integration/runtime/lifecycle/candidate.test.js .test-dist/test/integration/runtime/target-state-marker.test.js .test-dist/test/integration/runtime/target-state-recovery.test.js .test-dist/test/integration/runtime/user-payload.test.js",
    "benchmark:github-source": "npm run build --silent && node --expose-gc benchmarks/github-source/run.mjs",
    "check": "npm run typecheck && npm run build && npm test && npm run test:cli && npm run test:first-party",
    "test:target-state-marker": "npm run test:compile --silent && node --test .test-dist/test/integration/runtime/target-state-marker.test.js .test-dist/test/integration/runtime/target-state-recovery.test.js",
    "test:export-package": "npm run test:compile --silent && node --test .test-dist/test/behavior/domain/export/package-v1.test.js",
    "test:user-payload": "npm run test:compile --silent && node --test .test-dist/test/behavior/domain/export/user-payload-v1.test.js .test-dist/test/behavior/domain/export/package-v1.test.js .test-dist/test/integration/runtime/user-payload.test.js",
    "test:export-locked": "npm run test:compile --silent && node --test .test-dist/test/integration/runtime/export/dependencies.test.js",
    "test:export-full-locked": "npm run test:compile --silent && node --test .test-dist/test/integration/runtime/export/dependencies.test.js .test-dist/test/integration/runtime/export/full.test.js",
    "test:import-locked": "npm run test:compile --silent && node --test .test-dist/test/integration/runtime/import/exact.test.js",
    "test:import-merge-locked": "npm run test:compile --silent && node --test .test-dist/test/integration/runtime/import/exact.test.js .test-dist/test/integration/runtime/import/merge.test.js",
    "test:reproduction-locked": "npm run test:compile --silent && node --test .test-dist/test/integration/runtime/export/dependencies.test.js .test-dist/test/integration/runtime/export/full.test.js .test-dist/test/integration/runtime/import/exact.test.js .test-dist/test/integration/runtime/import/merge.test.js .test-dist/test/integration/runtime/reproduction/e2e.test.js",
    "test:import-recovery-locked": "npm run test:compile --silent && node --test .test-dist/test/integration/runtime/export/dependencies.test.js .test-dist/test/integration/runtime/import/exact.test.js .test-dist/test/integration/runtime/import/merge.test.js .test-dist/test/integration/runtime/import/recovery/exact.test.js .test-dist/test/integration/runtime/import/recovery/merge.test.js",
    "benchmark:exact-export": "npm run build --silent && node --expose-gc benchmarks/exact-export/run.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "smol-toml": "^1.8.0",
    "unicode-case-folding": "^1.1.1",
    "yaml": "^2.9.1"
  }
}
