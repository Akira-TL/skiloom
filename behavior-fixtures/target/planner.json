      "packages": [
        { "packageCoordinate": "org/app/main", "packageRoot": "skills/main", "contentDigest": "sha256:main" },
        { "packageCoordinate": "org/lib/core", "packageRoot": "skills/core", "contentDigest": "sha256:core" },
        { "packageCoordinate": "org/lib/helper", "packageRoot": "skills/helper", "contentDigest": "sha256:helper" },
        { "packageCoordinate": "other/tools/observer", "packageRoot": "observer", "contentDigest": "sha256:observer" }
