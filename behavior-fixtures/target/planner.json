          },
          {
            "packageCoordinate": "org/lib/core",
            "packageRoot": "skills/core",
            "contentDigest": "sha256:core",
            "activationName": "core-local",
            "projectionKind": "transformed-copy",
            "transform": {
              "rename": {
                "fromActivationName": "core",
                "toActivationName": "core-local"
              },
              "dependencyRoutes": []
            }
          },
          {
            "packageCoordinate": "org/lib/helper",
            "packageRoot": "skills/helper",
            "contentDigest": "sha256:helper",
            "activationName": "helper",
            "projectionKind": "direct",
            "transform": null
          },
          {
            "packageCoordinate": "other/tools/observer",
            "packageRoot": "observer",
            "contentDigest": "sha256:observer",
            "activationName": "observer",
            "projectionKind": "direct",
            "transform": null
